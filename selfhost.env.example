# Settings for self-hosted Open Gamer MCP (docs/self-host.md). Copy to .env
# next to docker-compose.yml and fill in. .env is git-ignored; never commit
# real values.
#
# Every line here reaches the platform service, so any setting in
# platform/.env.example may be added, except DATABASE_URL and PORT, which
# docker-compose.yml sets.

# The Postgres password. Letters and digits only, because it goes into a URL.
# For example: openssl rand -hex 32
POSTGRES_PASSWORD=

# The origin that browsers, agents, and bridges reach the service at, without
# a path or trailing slash, e.g. https://ogmcp.example.com. The MCP URL is
# <this>/mcp. http://localhost:4790 reaches it from this machine only.
PUBLIC_BASE_URL=http://localhost:4790

# The number of proxies in front of the service whose X-Forwarded-* headers
# are trusted. Set 1 behind one reverse proxy that terminates TLS. Default 0.
TRUST_PROXY_HOPS=

# Sign-in (§13.1). Set both names of at least one provider: nobody can sign
# in without one. Register these redirect URIs with the provider:
#   Google:  <PUBLIC_BASE_URL>/auth/google/callback
#   Discord: <PUBLIC_BASE_URL>/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Firecrawl API key, for search_game_info and fetch_game_page (§12).
# Optional: without it, both answer search_unavailable.
FIRECRAWL_API_KEY=

# The email address the Privacy and Terms pages (/privacy, /terms) give for
# questions (§13.2). Optional. Unset, the pages say contact details are coming
# soon. The pages describe the hosted service, with its default limits.
CONTACT_EMAIL=

# The hosted service's limits (§14) are off here. New users are on the free
# tier; platform/.env.example describes each limit, to set one.
# The device limit: off lets every user upload from any number of bridges.
DEVICES_PER_USER_FREE=off
# History retention: off keeps every user's uploads and snapshots forever.
FREE_RETENTION_DAYS=off

# The OAuth server's keys, OIDC_JWKS and OIDC_COOKIE_KEYS, are required. After
# the other values are set, this command appends fresh ones to .env:
#   docker compose build
#   docker compose run --rm --no-deps -T ogmcp node platform/dist/gen-oidc-keys.js >> .env
