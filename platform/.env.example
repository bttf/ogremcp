# Copy to `platform/.env` and fill in. `.env` is git-ignored; never commit real
# values. Production values live in the Railway service's variables.
# `pnpm --filter @ogmcp/platform start` reads `platform/.env` when it exists.

# Port the server listens on. Default 4790. 0 lets the system pick one.
# Railway sets it.
PORT=

# Postgres, as postgresql://user:password@host:port/database. Required: the
# server refuses to start without it, and no error repeats it. TLS follows the
# URL's sslmode, and a URL without sslmode connects without TLS. A database
# reached over the internet needs ?sslmode=verify-full, or the password and
# every row cross the network in plaintext. The start log says whether TLS is
# on. On Railway it references the project's Postgres service and connects
# over the private network, without TLS.
DATABASE_URL=

# Milliseconds a query waits for the database's answer before it fails and its
# connection is dropped. Default 5000.
DATABASE_QUERY_TIMEOUT_MS=

# The origin browsers reach the service at, without a path or trailing slash:
# https://ogmcp-production.up.railway.app on Railway, http://localhost:4790 on
# the local machine. Sign-in redirect URIs are <this>/auth/google/callback and
# <this>/auth/discord/callback. Session cookies are Secure when it is https.
# The POST /auth/signout Origin check compares against it. It is the OAuth
# issuer, and <this>/mcp is the MCP resource: /mcp refuses a Host header that
# does not name its host. Required when a sign-in provider is set; otherwise it
# defaults to http://localhost:<PORT>.
PUBLIC_BASE_URL=

# Origins that /mcp accepts in the Origin header, comma-separated (§9). A
# request with another Origin gets 403; a request without one passes. Each
# entry is an exact origin as a browser sends it: scheme, host, and a
# non-default port, no path, no wildcard. Unset, the list is PUBLIC_BASE_URL
# plus the target agents' web origins: https://claude.ai, https://chatgpt.com,
# https://chat.openai.com, https://www.perplexity.ai, https://perplexity.ai.
# A value replaces that whole list.
MCP_ALLOWED_ORIGINS=

# Proxies in front of the service whose X-Forwarded-* headers are trusted.
# Default 0: none. Railway sets 1 for its edge, which terminates TLS. Set it
# only to the number of proxies that really sit in front of the service: a
# client can write X-Forwarded-For itself.
TRUST_PROXY_HOPS=

# Google and Discord sign-in (§13.1). Set both names of a provider, or
# neither. A provider left unset stays off and its routes answer 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Days a web session lasts after it was created or last renewed. Default 30.
WEB_SESSION_LIFETIME_DAYS=
# A web session used with fewer days than this left is renewed. Default 15,
# and at most WEB_SESSION_LIFETIME_DAYS.
WEB_SESSION_RENEW_WITHIN_DAYS=

# The OAuth server's keys (§9, §13.1). Set both, or neither. After a build,
#   pnpm -s --filter @ogmcp/platform gen-oidc-keys
# prints fresh values for both as KEY=value lines. Without them the server
# makes keys at each start, which stop working at the next restart. Only a
# local run may do that: PUBLIC_BASE_URL on http://localhost and NODE_ENV not
# production. Anywhere else the server refuses to start. No message repeats
# a key.
#
# OIDC_JWKS: the private signing keys, as a JSON Web Key Set on one line. The
# discovery document's jwks_uri publishes their public halves. To rotate, put
# the new key first and keep the old one until the tokens it signed expire.
OIDC_JWKS=
# OIDC_COOKIE_KEYS: keys that sign the OAuth server's cookies, comma-separated,
# each at least 32 characters. The first signs and every one verifies. To
# rotate, put the new key first.
OIDC_COOKIE_KEYS=

# OAuth token lifetimes (§9). An access token lasts
# OAUTH_ACCESS_TOKEN_LIFETIME_MINUTES (default 60). A refresh token lasts
# OAUTH_REFRESH_TOKEN_LIFETIME_DAYS (default 30), and each use replaces it with
# a new one. A grant, the user's approval of an agent or a bridge, lasts
# OAUTH_GRANT_LIFETIME_DAYS (default 365, and at least the refresh token
# lifetime); its tokens end with it, so the user approves again after that.
OAUTH_ACCESS_TOKEN_LIFETIME_MINUTES=
OAUTH_REFRESH_TOKEN_LIFETIME_DAYS=
OAUTH_GRANT_LIFETIME_DAYS=

# Client ID metadata documents (§9): an agent whose client_id is an https URL
# is registered by the document at that URL, which the OAuth server fetches
# and caches. It also fetches and caches the JWKS of such an agent that signs
# its token requests. Fetches per minute: all together (default 120), from one
# host (default 30), and caused by requests from one client address, an IPv6
# address by its /64 (default 10). A cached document needs no fetch. The
# counts are per process.
CIMD_FETCHES_PER_MINUTE=
CIMD_FETCHES_PER_HOST_PER_MINUTE=
CIMD_FETCHES_PER_IP_PER_MINUTE=
# Exact client_id URLs, comma-separated, whose documents and JWKS are fetched
# without those limits, so no flood can block them. Unset: the client_ids of
# Claude (https://claude.ai/oauth/mcp-oauth-client-metadata), Claude Code
# (https://claude.ai/oauth/claude-code-client-metadata), and ChatGPT
# (https://chatgpt.com/oauth/client.json). A value replaces that list.
CIMD_TRUSTED_CLIENT_IDS=

# Dynamic client registration at /oauth/register (§9), limited by token
# buckets. Each client address (an IPv6 address counts by its /64) may
# register DCR_BURST clients at once (default 5), refilled at
# DCR_RATE_PER_HOUR (default 10). The addresses in DCR_TRUSTED_RANGES, a
# comma-separated list of CIDR ranges (default 160.79.104.0/21, Anthropic's
# egress range, where Claude registers from), share one bucket instead:
# DCR_TRUSTED_BURST (default 60) and DCR_TRUSTED_RATE_PER_HOUR (default 600).
# All registrations together are limited to DCR_GLOBAL_BURST (default 100)
# and DCR_GLOBAL_RATE_PER_HOUR (default 1000). Past a limit, 429.
DCR_RATE_PER_HOUR=
DCR_BURST=
DCR_TRUSTED_RANGES=
DCR_TRUSTED_RATE_PER_HOUR=
DCR_TRUSTED_BURST=
DCR_GLOBAL_RATE_PER_HOUR=
DCR_GLOBAL_BURST=

# A registered client that has not got a token for OAUTH_CLIENT_UNUSED_DAYS
# (default 90), counted from its registration when it never has, is deleted
# with its grants and tokens, by a job that runs at start and once a day. Its
# agent then registers again.
OAUTH_CLIENT_UNUSED_DAYS=

# User codes entered at /device that match no waiting bridge (§8.1), limited
# by token buckets. Each signed-in user may miss DEVICE_CODE_MISS_BURST times
# at once (default 10), refilled at DEVICE_CODE_MISS_RATE_PER_HOUR (default
# 10). All users' misses together are limited to DEVICE_CODE_MISS_GLOBAL_BURST
# (default 100) and DEVICE_CODE_MISS_GLOBAL_RATE_PER_HOUR (default 1000). Past
# a limit, the page's lookups get 429.
DEVICE_CODE_MISS_RATE_PER_HOUR=
DEVICE_CODE_MISS_BURST=
DEVICE_CODE_MISS_GLOBAL_RATE_PER_HOUR=
DEVICE_CODE_MISS_GLOBAL_BURST=

# The cap on one upload's uncompressed bytes at POST /api/v1/ingest (§8.3).
# Default 5242880 (5 MB). An upload over it gets 413 too_large. The gzip is
# decompressed with this as a hard limit, and the compressed part may be at
# most this plus a small margin. The WoW interpreter has its own 5 MB limit.
INGEST_MAX_UNCOMPRESSED_BYTES=

# The ingest rate limit (§8.3), by token buckets. Each source instance of a
# device (kit, source, and instance) may upload INGEST_BURST times at once
# (default 3), refilled at INGEST_RATE_PER_MINUTE (default 12: one upload per
# 5 seconds). Each device, all its instances together, may upload
# INGEST_DEVICE_BURST times at once (default 10), refilled at
# INGEST_DEVICE_RATE_PER_MINUTE (default 30). Past either, 429 rate_limited
# with Retry-After in whole seconds. The buckets are per process.
INGEST_RATE_PER_MINUTE=
INGEST_BURST=
INGEST_DEVICE_RATE_PER_MINUTE=
INGEST_DEVICE_BURST=

# The most snapshots one history read of a kit tool returns (§6.2), such as
# wow_get_history's. Default 100. A tool that asks for more gets this many.
HISTORY_MAX_SNAPSHOTS=

# The most recent characters list_games returns per game (§10.3). Default 5.
LIST_GAMES_CHARACTERS=

# Where the Get started page links to download the bridge (§7, §13.2), as an
# https URL. Optional. Unset, the page says the download is not available yet.
BRIDGE_DOWNLOAD_URL=

# The least severe log level written: debug, info, warn, or error. Default
# info. Logs are JSON lines on stdout (§16). Each request gets one access line
# at info; the health checks' are at debug.
LOG_LEVEL=
