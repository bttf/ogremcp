# Copy to `platform/.env` and fill in. `.env` is git-ignored; never commit real
# values. Production values live in the Railway service's variables.
# `pnpm --filter @ogmcp/platform start` reads `platform/.env` when it exists.

# Port the server listens on. Default 4790. 0 lets the system pick one.
# Railway sets it.
PORT=

# Postgres, as postgresql://user:password@host:port/database. Required: the
# server refuses to start without it, and no error repeats it. TLS follows the
# URL's sslmode. On Railway it references the project's Postgres service and
# connects over the private network.
DATABASE_URL=
