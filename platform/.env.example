# Copy to `platform/.env` and fill in. `.env` is git-ignored; never commit real
# values. Production values live in the Railway service's variables.
# `pnpm --filter @ogmcp/platform start` reads `platform/.env` when it exists.

# Port the server listens on. Default 4790. 0 lets the system pick one.
# Railway sets it.
PORT=

# Postgres, as postgresql://user:password@host:port/database. Required: the
# server refuses to start without it, and no error repeats it. TLS follows the
# URL's sslmode, and a URL without sslmode connects without TLS. A database
# reached over the internet needs ?sslmode=verify-full, or the password and
# every row cross the network in plaintext. The start log says whether TLS is
# on. On Railway it references the project's Postgres service and connects
# over the private network, without TLS.
DATABASE_URL=

# Milliseconds a query waits for the database's answer before it fails and its
# connection is dropped. Default 5000.
DATABASE_QUERY_TIMEOUT_MS=
