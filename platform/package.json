{
  "name": "@ogmcp/platform",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/kits/build.js && vite build web",
    "dev:web": "vite web",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "gen-oidc-keys": "node dist/gen-oidc-keys.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ogmcp/kit-wow": "workspace:*",
    "@ogmcp/sdk": "workspace:*",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "oidc-provider": "~9.12.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/oidc-provider": "~9.12.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
